# Nomade backend env (F1.4) — placeholders only. Copy to `.env.local` (never commit).
# Local keys: run `supabase status` after `supabase start`.
# Dev hosted: nomade-dev project ref bgdrzdlenmwbpalnjiqg (us-west-2).
# Prod (nomade-prod whjzynfsifrtrxlylrww): human-gated — do not wire in F1.4.
# See docs/backend-env.md

# Required — Supabase project URL (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Required — anon / publishable key (NEVER the service_role key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Required — server only (Vercel server env / .env.local). Never NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — non-secret diagnostic ref (e.g. bgdrzdlenmwbpalnjiqg or "local")
# SUPABASE_PROJECT_REF=bgdrzdlenmwbpalnjiqg

# Optional at boot — required only for chat routes that call Anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional at boot — required for GET|POST /api/cron/purge-accounts (F2.6p).
# Value from Keeper only; never commit. Vercel Cron sends Authorization: Bearer ${CRON_SECRET}.
# CRON_SECRET=your-cron-secret
# F8: the same CRON_SECRET gates the manual GET|POST /api/cron/check-sources (no vercel.json cron).

# Optional — F8 /api/sources admin writes. Comma-separated Supabase Auth user UUIDs (Cap-approved).
# Unset → only Authorization: Bearer ${SUPABASE_SERVICE_ROLE_KEY} may POST/PATCH/DELETE.
# SOURCES_ADMIN_USER_IDS=

# Optional at boot — required only when POST /api/account/delete includes appleAuthorizationCode (F2.6r).
# Names only. Values from Keeper → Preview / local .env.local. Never commit. Do not set on nomade-prod in this ticket.
# APPLE_CLIENT_ID is the App ID (not a Services ID). APPLE_PRIVATE_KEY is the .p8 PEM (headers included).
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_CLIENT_ID=com.izaya.Nomade

# Optional at boot — required for POST /api/billing/app-store/transactions (F10).
# ASC sandbox product id from Keeper only. NEVER invent or commit a real/fake ASC product id.
# APP_STORE_JOURNEY_PRODUCT_ID=
# Optional — defaults to com.izaya.Nomade (public App ID / bundle).
# APP_STORE_BUNDLE_ID=com.izaya.Nomade
# F10: "true" accepts Sandbox/Xcode transactions (set true on Preview + Production for App Review).
# APP_STORE_ALLOW_SANDBOX=false
# F10 paywall flag. Default OFF: Apply/After-arrival writes are not gated and full
# details are returned (access + entitlement still in the checklist payload).
# Set "true" only when the iOS paywall ships.
# BILLING_GATE_ENABLED=false

# F11a intake flag. Default OFF: /api/journey/intake → 404 INTAKE_DISABLED, sync
# intake ops are rejected (INTAKE_DISABLED), the checklist ignores stored answers
# (export still includes them). Set "true" on Preview; Production stays off until Isaias flips it.
# INTAKE_ENABLED=false
